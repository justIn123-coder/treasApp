rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- TreasApp Rules ---
    // This allows TreasApp to sync data based on the Student ID (userId).
    // It enables offline-first cloud backup and recovery without breaking other apps.
    match /users/{userId} {
      allow read, write: if true;
      
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // --- Your Existing App Rules ---
    // Profiles: Everyone can see classmates, but you must be logged in to update your own
    match /profiles/{uid} {
      allow read: if true; 
      allow write: if request.auth != null; 
    }

    // Friendships & Messages: Require authentication (Anonymous or Email)
    match /friendships/{fid} {
      allow read, write: if request.auth != null;
    }

    match /messages/{mid} {
      allow read, write: if request.auth != null;
    }

    match /conversations/{cid} {
      allow read, write: if request.auth != null;
    }

    // Shared resources: Open for the classroom community
    match /assignments/{aid} {
      allow read, write: if true;
    }

    match /calendar_events/{eid} {
      allow read, write: if true;
    }
  }
}